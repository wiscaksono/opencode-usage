<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Read-only access to the app-published usage snapshot. The widget does
	     no networking and never touches the API key, so no network.client. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/com.wiscaksono.opencode-usage/widget-snapshot.json</string>
	</array>
	<!-- Write access limited to the single refresh-request flag file. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/com.wiscaksono.opencode-usage/widget-refresh-requested</string>
	</array>
</dict>
</plist>
